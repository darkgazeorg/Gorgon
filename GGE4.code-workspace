{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"clangd.arguments": [
        	"--compile-commands-dir=${command:cmake.buildDirectory}"
        ],
        "chat.tools.terminal.autoApprove": {
            "ctest": true,
            "cmake": true
        }
	},
	"tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Elevated Install Gorgon",
                "type": "process",
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": [],
                "windows": {
                    "command": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-File",
                        "${workspaceFolder}\\Scripts\\ElevatedInstall.ps1",
                        "-CMakeExecutable",
                        "cmake",
                        "-BuildDirectory",
                        "${command:cmake.buildDirectory}",
                        "-Configuration",
                        "${command:cmake.buildType}"
                    ]
                },
                "linux": {
                    "command": "sudo",
                    "args": [
                        "cmake",
                        "--install",
                        "${command:cmake.buildDirectory}",
                        "--config",
                        "${command:cmake.buildType}"
                    ]
                }
            },
            {
                "label": "Elevated Clean Install Gorgon",
                "type": "process",
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": [],
                "windows": {
                    "command": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-File",
                        "${workspaceFolder}\\Scripts\\ElevatedCleanInstall.ps1",
                        "-CMakeExecutable",
                        "cmake",
                        "-BuildDirectory",
                        "${command:cmake.buildDirectory}",
                        "-Configuration",
                        "${command:cmake.buildType}"
                    ]
                },
                "linux": {
                    "command": "sudo",
                    "args": [
                        "bash",
                        "-c",
                        "echo 'Wiping old installation...'; rm -rf /usr/local/include/Gorgon /usr/local/lib/cmake/Gorgon /usr/local/share/doc/Gorgon /usr/local/lib/libGorgon*; cmake --install '${command:cmake.buildDirectory}' --config '${command:cmake.buildType}'"
                    ]
                }
            },
            {
                "label": "Build Active Launch Target",
                "type": "shell",
                "command": "cmake",
                "args": [
                    "--build",
                    "${command:cmake.buildDirectory}",
                    "--target",
                    "${command:cmake.launchTargetName}"
                ],
                "group": "build",
                "problemMatcher": [
                    "$gcc",
                    "$msCompile"
                ],
                "presentation": {
                    "reveal": "always",
                    "panel": "shared",
                    "clear": true
                },
                "detail": "Dynamically builds whatever target is selected in the CMake Launch list."
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Windows: Debug Selected Target",
                "type": "cppvsdbg",
                "request": "launch",
                "program": "${command:cmake.launchTargetPath}",
                "args": [],
                "stopAtEntry": false,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": false,
                "preLaunchTask": "Build Active Launch Target"
            },
            {
                "name": "Linux: Debug Selected Target",
                "type": "cppdbg",
                "request": "launch",
                "program": "${command:cmake.launchTargetPath}",
                "args": [],
                "stopAtEntry": false,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": false,
                "MIMode": "gdb",
                "preLaunchTask": "Build Active Launch Target",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            }
        ]
    }
}
