@PACKAGE_INIT@

list(APPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)

# ==============================================================================
# 1. Mandatory Core Dependencies
# ==============================================================================
find_dependency(Threads)
find_dependency(PNG)
find_dependency(JPEG)
find_dependency(ZLIB)
find_dependency(LibLZMA)
find_dependency(GLEW)

# ==============================================================================
# 2. OS-Specific Core Dependencies & Compiler State
# ==============================================================================
if(WIN32)
    # cpptrace is strictly required on Windows
    find_dependency(cpptrace CONFIG)
    
    # Force the client application to use the static CRT to match Gorgon's binaries.
    # This automatically applies /MTd for Debug and /MT for Release.
    if(POLICY CMP0091)
        cmake_policy(SET CMP0091 NEW)
    endif()
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
else()
    # PkgConfig is required on Linux
    find_package(PkgConfig REQUIRED)
endif()

# ==============================================================================
# 3. Optional Dependencies (Baked in during Gorgon's build)
# ==============================================================================
# Capture the toggle states from the Gorgon build
set(GORGON_HAS_OPENGL "@GORGON_GL_OPENGL@")
set(GORGON_HAS_FREETYPE "@FreeType@")
set(GORGON_HAS_FONTCONFIG "@FONTCONFIG@")
set(GORGON_HAS_FLAC "@FLAC@")
set(GORGON_HAS_OGG "@OGG@")
set(GORGON_HAS_VORBIS "@VORBIS@")
set(GORGON_HAS_HTTP "@HTTP@")
set(GORGON_AUDIOLIB "@AUDIOLIB@")

if(GORGON_HAS_OPENGL)
    find_dependency(OpenGL)
endif()

if(GORGON_HAS_FREETYPE)
    find_dependency(Freetype)
    
    # When FreeType is built statically via vcpkg on Windows, it requires 
    # BZip2 and Brotli. Standard CMake FindFreetype is unaware of this.
    if(WIN32)
        find_dependency(BZip2)
        find_dependency(unofficial-brotli CONFIG)
        
        # Patch the imported Freetype target to forcefully link the missing compression libraries
        if(TARGET Freetype::Freetype)
            set_property(TARGET Freetype::Freetype APPEND PROPERTY INTERFACE_LINK_LIBRARIES 
                BZip2::BZip2 
                unofficial::brotli::brotlidec 
                unofficial::brotli::brotlicommon
            )
        endif()
    endif()
endif()

if(GORGON_HAS_FONTCONFIG AND NOT WIN32)
    find_dependency(Fontconfig)
endif()

if(GORGON_HAS_FLAC)
    find_dependency(FLAC)
endif()

if(GORGON_HAS_OGG)
    find_dependency(Ogg)
endif()

if(GORGON_HAS_HTTP)
    find_dependency(CURL)
endif()

# ==============================================================================
# 4. Complex / PkgConfig Dependencies
# ==============================================================================
if(GORGON_HAS_VORBIS)
    if(WIN32)
        # On Windows (vcpkg), Vorbis provides standard CMake configs
        find_dependency(Vorbis CONFIG)
    else()
        # On Linux, we must use pkg_check_modules to populate PkgConfig::VORBIS
        pkg_check_modules(VORBIS REQUIRED IMPORTED_TARGET vorbis vorbisfile)
    endif()
endif()

if(GORGON_AUDIOLIB STREQUAL "PULSE" AND NOT WIN32)
    # On Linux, PulseAudio is found via PkgConfig
    pkg_check_modules(PULSE REQUIRED IMPORTED_TARGET libpulse)
endif()

# ==============================================================================
# 5. Exported Targets & Functions
# ==============================================================================
# Include the exported targets (the compiled libraries)
include("${CMAKE_CURRENT_LIST_DIR}/GorgonTargets.cmake")

# Include the custom framework functions (e.g., gorgon_copy_directory)
include("${CMAKE_CURRENT_LIST_DIR}/Public.cmake")
