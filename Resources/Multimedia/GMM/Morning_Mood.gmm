# =========================================================
# Morning Mood (Peer Gynt Suite No. 1 - Orchestral)
# =========================================================
%CHANNELS = 2
%title = Morning Mood
%artist = Edvard Grieg
%arranger = Antigravity
%genre = classical
%style = orchestral
%comment = A peaceful, slow 6/8 arrangement of Edvard Grieg's pastoral masterpiece.
%comment = Employs flutes, oboes, and deep bass to create a warm morning soundscape.

# --- Instrument Bank ---
@1 = flute volume=95
@2 = synth(Oboe) attack={s, 32}, decay={linear, 2}, sustain=0.7, release={exp, 4}, volume=70
@3 = "deep sub bass" volume=80

T70

