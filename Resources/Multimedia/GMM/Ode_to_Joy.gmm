# =========================================================
# Ode to Joy (Symphony No. 9 - Classical/Majestic)
# =========================================================
%CHANNELS = 2
%title = Ode to Joy
%artist = Ludwig van Beethoven
%arranger = Antigravity
%genre = classical
%style = orchestral
%comment = A majestic, multi-minute orchestral synth arrangement of Ode to Joy.
%comment = Features brassy leads, electric piano accompaniment, and deep bass.

# --- Instrument Bank ---
@1 = synth attack={linear, 16}, decay={linear, 4}, sustain=0.8, release={exp, 4}, volume=80
@2 = "electric piano" volume=70
@3 = "deep sub bass" volume=85
@4 = xylophone volume=60

T120 V50

