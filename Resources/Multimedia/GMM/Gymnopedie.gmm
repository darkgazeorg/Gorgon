# =========================================================
# Gymnopédie No. 1
# =========================================================
%CHANNELS = 2
%title = Gymnopédie No. 1
%artist = Erik Satie
%arranger = Antigravity
%genre = classical
%style = ambient
%comment = A slow, atmospheric, and highly relaxing arrangement of Gymnopédie No. 1.
%comment = Recreates the iconic alternating bass-chord structure and floating melody.

# --- Instrument Bank ---
@1 = "electric piano" volume=85
@2 = "ambient pad" volume=55
@3 = "deep sub bass" volume=85

T40

# ---------------------------------------------------------
# INTRO (4 Measures)
# ---------------------------------------------------------
# Track 1: Melody (rests during intro)
1> R2. R2. R2. R2.

# Track 2: Accompaniment (Lush chords)
2> @2
2> R4 O3 F+4 B4 R4 O3 F+4 A4 R4 O3 F+4 B4 R4 O3 F+4 A4

# Track 3: Bass
3> @3
3> O2 G2. O2 D2. O2 G2. O2 D2.

