%artist = Traditional Folk
%arranger = Antigravity
%genre = folk
%style = acoustic
%comment = A gentle, multi-minute acoustic arrangement of Greensleeves.
%comment = Utilizes flute, electric piano, and sub-bass for a warm and relaxing texture.

# --- Instrument Bank ---
