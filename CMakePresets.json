{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Default",
      "inherits": "linux-base",
      "displayName": "Default Linux Build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "Quick",
      "inherits": "linux-base",
      "displayName": "Quick Linux Build",
      "description": "Documentation is disabled for a quick build and installation.",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "Minimal",
      "inherits": "linux-base",
      "displayName": "Minimal Linux Build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUDIO": "OFF",
        "SCRIPTING": "OFF",
        "UI": "OFF",
        "CGI": "OFF",
        "HTTP": "OFF",
        "FLAC": "OFF",
        "FreeType": "OFF",
        "OGG": "OFF",
        "VORBIS": "OFF",
        "FONTCONFIG": "OFF",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "Testing",
      "inherits": "linux-base",
      "displayName": "Testing & Examples",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TESTS": "ON",
        "UNIT_TESTS": "ON",
        "MANUAL_TESTS": "ON",
        "BUILD_EXAMPLES": "ON",
        "EXPORT_BUILD_TREE": "ON"
      }
    },
    {
      "name": "DocumentationMode",
      "inherits": "linux-base",
      "displayName": "Documentation Mode",
      "cacheVariables": {
        "DOCUMENTATION": "ON",
        "DOCUMENTATION_MODE": "ON"
      }
    },
    {
      "name": "Maintainer",
      "hidden": false,
      "inherits": "Testing",
      "displayName": "Maintainer Mode",
      "description": "Multi-config environment for debugging releases and developing the framework.",
      "binaryDir": "${sourceDir}/build/Maintainer",
      "cacheVariables": {
        "MAINTAINER": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",        
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "WindowsDefault",
      "inherits": "windows-base",
      "displayName": "Windows Default Build",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "flac;ogg;vorbis;freetype;curl" 
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsQuick",
      "inherits": "WindowsDefault",
      "displayName": "Windows Quick Build",
      "cacheVariables": {
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "WindowsMinimal",
      "inherits": "windows-base",
      "displayName": "Windows Minimal Build",
      "cacheVariables": {
        "AUDIO": "OFF",
        "SCRIPTING": "OFF",
        "UI": "OFF",
        "CGI": "OFF",
        "HTTP": "OFF",
        "FLAC": "OFF",
        "FreeType": "OFF",
        "OGG": "OFF",
        "VORBIS": "OFF",
        "FONTCONFIG": "OFF",
        "DOCUMENTATION": "OFF",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": ""
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsTesting",
      "inherits": "windows-base",
      "displayName": "Windows Testing & Examples",
      "cacheVariables": {
        "TESTS": "ON",
        "UNIT_TESTS": "ON",
        "MANUAL_TESTS": "ON",
        "BUILD_EXAMPLES": "ON",
        "EXPORT_BUILD_TREE": "ON",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "flac;ogg;vorbis;freetype;curl"
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsMaintainer",
      "inherits": "WindowsTesting",
      "displayName": "Windows Maintainer Mode",
      "description": "Includes RelWithDebInfo to catch memory/race issues in optimized builds.",
      "cacheVariables": {
        "MAINTAINER": "ON",        
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "windows-vs2022-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",        
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "WindowsVS2022",
      "inherits": "windows-vs2022-base",
      "displayName": "Windows Visual Studio 2022",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "flac;ogg;vorbis;freetype;curl" 
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
"buildPresets": [
    {
      "name": "Linux-Install-SDK",
      "configurePreset": "Default",
      "displayName": "Install Gorgon SDK (Multi-Config)",
      "targets": [
        "install_sdk"
      ]
    },
    {
      "name": "Windows-Install-SDK",
      "configurePreset": "WindowsDefault",
      "displayName": "Install Gorgon SDK (Windows Multi-Config)",
      "targets": [
        "install_sdk"
      ]
    },
    {
      "name": "Debug",
      "configurePreset": "Maintainer",
      "displayName": "Build Debug",
      "configuration": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Maintainer",
      "displayName": "Build Release",
      "configuration": "Release"
    },
    {
      "name": "RelWithDebInfo",
      "configurePreset": "Maintainer",
      "displayName": "Build RelWithDebInfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "Win-Debug",
      "configurePreset": "WindowsMaintainer",
      "displayName": "Build Debug (Windows)",
      "configuration": "Debug"
    },
    {
      "name": "Win-Release",
      "configurePreset": "WindowsMaintainer",
      "displayName": "Build Release (Windows)",
      "configuration": "Release"
    },
    {
      "name": "Win-RelWithDebInfo",
      "configurePreset": "WindowsMaintainer",
      "displayName": "Build RelWithDebInfo (Windows)",
      "configuration": "RelWithDebInfo"
    }
  ]
}