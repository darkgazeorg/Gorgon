{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    
    {
      "name": "Quick",
      "inherits": "linux-base",
      "displayName": "Quick Linux Build",
      "description": "Documentation is disabled for a quick build and installation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "QuickDebug",
      "inherits": "linux-base",
      "displayName": "Quick Linux Debug Build",
      "description": "Quick build with debug configuration and no documentation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "QuickRelease",
      "inherits": "linux-base",
      "displayName": "Quick Linux Release Build",
      "description": "Quick build with release configuration and no documentation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "Default",
      "inherits": "linux-base",
      "displayName": "Default Linux Build",
      "description": "Standard configuration with all default modules and features enabled.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "DefaultDebug",
      "inherits": "linux-base",
      "displayName": "Default Linux Debug Build",
      "description": "Standard configuration in debug mode.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "DefaultRelease",
      "inherits": "linux-base",
      "displayName": "Default Linux Release Build",
      "description": "Standard configuration in release mode.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Minimal",
      "inherits": "linux-base",
      "displayName": "Minimal Linux Build",
      "description": "Disables all optional modules and external format support for a core-only build.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUDIO": "OFF",
        "SCRIPTING": "OFF",
        "UI": "OFF",
        "CGI": "OFF",
        "HTTP": "OFF",
        "FLAC": "OFF",
        "FreeType": "OFF",
        "OGG": "OFF",
        "VORBIS": "OFF",
        "FONTCONFIG": "OFF",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "Testing",
      "inherits": "linux-base",
      "displayName": "Testing & Examples",
      "description": "Enables unit tests, manual tests, and builds example applications.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TESTS": "ON",
        "UNIT_TESTS": "ON",
        "MANUAL_TESTS": "ON",
        "BUILD_EXAMPLES": "ON",
        "EXPORT_BUILD_TREE": "ON"
      }
    },
    {
      "name": "TestingRelWithDebInfo",
      "inherits": "Testing",
      "displayName": "Testing & Examples (RelWithDebInfo)",
      "description": "Testing build with RelWithDebInfo configuration.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "Coverage",
      "inherits": "Testing",
      "displayName": "Code Coverage",
      "description": "Testing build with code coverage instrumentation enabled.",
      "cacheVariables": {
        "COVERAGE": "ON"
      }
    },
    {
      "name": "DocumentationMode",
      "inherits": "linux-base",
      "displayName": "Documentation Mode",
      "description": "Builds documentation with strict warning reporting enabled.",
      "cacheVariables": {
        "DOCUMENTATION": "ON",
        "DOCUMENTATION_MODE": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.tools/ninja/ninja.exe",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",        
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "WindowsQuick",
      "inherits": "windows-base",
      "displayName": "Windows Quick Build",
      "description": "Documentation is disabled for a quick build and installation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "WindowsQuickDebug",
      "inherits": "windows-base",
      "displayName": "Windows Quick Debug Build",
      "description": "Quick build with debug configuration and no documentation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "WindowsQuickRelease",
      "inherits": "windows-base",
      "displayName": "Windows Quick Release Build",
      "description": "Quick build with release configuration and no documentation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DOCUMENTATION": "OFF"
      }
    },
    {
      "name": "WindowsDefault",
      "inherits": "windows-base",
      "displayName": "Windows Default Build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "flac;ogg;vorbis;freetype;curl" 
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsDefaultDebug",
      "inherits": "windows-base",
      "displayName": "Windows Default Debug Build",
      "description": "Standard default build in debug mode.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "flac;ogg;vorbis;freetype;curl"
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsDefaultRelease",
      "inherits": "windows-base",
      "displayName": "Windows Default Release Build",
      "description": "Standard default build in release mode.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "flac;ogg;vorbis;freetype;curl"
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsMinimal",
      "inherits": "windows-base",
      "displayName": "Windows Minimal Build",
      "description": "Core-only build with optional modules and external formats disabled.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUDIO": "OFF",
        "SCRIPTING": "OFF",
        "UI": "OFF",
        "CGI": "OFF",
        "HTTP": "OFF",
        "FLAC": "OFF",
        "FreeType": "OFF",
        "OGG": "OFF",
        "VORBIS": "OFF",
        "FONTCONFIG": "OFF",
        "DOCUMENTATION": "OFF",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": ""
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsTesting",
      "inherits": "windows-base",
      "displayName": "Windows Testing & Examples",
      "description": "Enables unit tests, manual tests, and example applications.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TESTS": "ON",
        "UNIT_TESTS": "ON",
        "MANUAL_TESTS": "ON",
        "BUILD_EXAMPLES": "ON",
        "EXPORT_BUILD_TREE": "ON",
        "VCPKG_MANIFEST_FEATURES": {
          "type": "STRING",
          "value": "flac;ogg;vorbis;freetype;curl"
        },
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "WindowsTestingRelWithDebInfo",
      "inherits": "WindowsTesting",
      "displayName": "Windows Testing & Examples (RelWithDebInfo)",
      "description": "Testing build with RelWithDebInfo configuration.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "WindowsCoverage",
      "inherits": "WindowsTesting",
      "displayName": "Windows Code Coverage",
      "description": "Testing build with code coverage instrumentation enabled.",
      "cacheVariables": {
        "COVERAGE": "ON"
      }
    },
    {
      "name": "WindowsDocumentationMode",
      "inherits": "windows-base",
      "displayName": "Windows Documentation Mode",
      "description": "Builds documentation with strict warning reporting enabled.",
      "cacheVariables": {
        "DOCUMENTATION": "ON",
        "DOCUMENTATION_MODE": "ON"
      }
    }
  ]
}
